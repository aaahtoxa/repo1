    {
      "name": "TC-POSTS-05: Verify full update of a post via PUT /posts/{id}",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains updated title\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.title).to.eql(\"updated title\");\r\n});\r\n"
            ]
          }
        }
      ],
