    {
      "name": "Validate JSON response structure and required fields for single post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Response has required fields\", function() {\r\n  var jsonData = pm.response.json();\r\n  pm.expect(jsonData).to.have.property('id');\r\n  pm.expect(jsonData).to.have.property('title');\r\n  pm.expect(jsonData).to.have.property('body');\r\n  pm.expect(jsonData).to.have.property('userId');\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/posts/1",
          "protocol": "https",
