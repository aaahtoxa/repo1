    {
      "name": "TC-POSTS-07: Demonstrate PATCH (partial update) understanding (API does not support it)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Server returns 404 as JSONPlaceholder does not support PATCH\", function () {\r\n    pm.response.to.have.status(404);\r\n});\r\n\r\npm.test(\"Response indicates unsupported method (expected behavior)\", function () {\r\n    var jsonData = pm.response.json();\r\n    // Тут можно проверить, что тело ответа пустое или содержит заглушку\r\n    pm.expect(jsonData).to.be.an('object');\r\n});\r\n"
            ]
          }
        }
      ],
